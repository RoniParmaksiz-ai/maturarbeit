   "source": [
    "from pandas import test\n",
    "import swissparlpy as spp\n",
    "from swissparlpy import SwissParlClient\n",
    "import pandas as pd\n",
    "from datetime import datetime, time, timezone\n",
    "import os\n",
    "\n",
    "odata_client = SwissParlClient(backend=\"odata\")\n",
    "test_data_tables = odata_client.get_tables()\n",
    "\n",
    "folder = \"parlament_data\"\n",
    "\n",
    "os.makedirs(folder, exist_ok=True)\n",
    "\n",
    "\n",
    "def save_transcripts_to_pkl(transcripts_data, folder, filename, date_from, date_to):\n",
    "     date_from = datetime.fromisoformat(f\"{year}-01-01\").replace(tzinfo=timezone.utc)\n",
    "     date_to = datetime.fromisoformat(f\"{year + 1}-01-01\").replace(tzinfo=timezone.utc)\n",
    "     transcripts_data = odata_client.get_data(\n",
    "        \"Transcript\",\n",
    "        Language=\"DE\",\n",
    "        Start__gt=(date_from),\n",
    "        End__lte=(date_to) \n",
    "    )\n",
    "     print(f\"{transcripts_data.count} rows loaded\")\n",
    "     df = pd.DataFrame(transcripts_data)\n",
    "     pickle_path = os.path.join(folder, filename)\n",
    "     df.to_pickle(pickle_path)\n",
    "     print(f\"Data saved to {pickle_path}\")\n",
    "\n",
    "\n",
    "for year in range(2000, 2001):\n",
    "\n",
    "    filename = f\"transcripts_{year}.pkl\"\n",
    "    pickle_path = os.path.join(folder, filename)\n",
    "\n",
    "    if os.path.exists(pickle_path):\n",
    "        print(f\"Skipping {year}, already downloaded.\")\n",
    "        continue\n",
    "\n",
    "    date_from = f\"{year}-01-01\"\n",
    "    date_to = f\"{year + 1}-01-01\"\n",
    "\n",
    "    print(f\"\\nDownloading transcripts for year {year}\")\n",
    "\n",
    "\n",
    "    save_transcripts_to_pkl(\n",
    "         None, folder, filename, date_from, date_to\n",
    "    )\n",
    "\n",
    "\n",
    "files = [\n",
    "    os.path.join(folder, x)\n",
    "    for x in os.listdir(folder)\n",
    "    if x.startswith(\"transcripts_\") and x.endswith(\".pkl\")\n",
    "]\n",
    "\n",
    "if files:\n",
    "    df_transcripts = pd.concat(\n",
    "        [pd.read_pickle(file) for file in files],\n",
    "        ignore_index=True\n",
    "    )\n",
    "\n",
    "    print(f\"\\nTotal transcripts: {len(df_transcripts)}\")\n",
    "\n",
    "    df_transcripts.to_pickle(\n",
    "        os.path.join(folder, \"all_transcripts.pkl\")\n",
    "    )\n",
    "\n",
    "\n",
    "# finally worked now i just need to be able to open it"
    "\n",
    "odata_client = SwissParlClient(backend=\"odata\")\n",
    "data_tables = odata_client.get_tables()\n",
    "\n",
    "test_transcripts_df = odata_client.get_glimpse(\"Transcript\").to_dataframe()\n",
    "\n",
    "\n",
    "print(test_transcripts_df)\n"
   ]
